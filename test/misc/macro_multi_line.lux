[doc invoking a macro with a multiline argument]

[macro hello A B]
    
[endmacro]

[invoke hello "Is\nthis\na\nmulti line\nstring?" "How\nabout\nthis?\n"]

"""[invoke hello "
This is
also a multi
line string"
"So is
this"]
"""

[invoke hello "this will work"
"""
multi-line string
at the end of invoke macro
"""]

[shell foo]
    [invoke hello "invoke macro in a shell"
    """
    with multi-line string
    param is fine
    """]

